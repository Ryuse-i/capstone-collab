# Member Workload Calculation
backend/app/modules/redistribution_recommendations/workload_calculation.py
backend/app/modules/member_snapshots.model.py - contains MemberSnapshot and MemberStatus used extensively in workload calculation and redistribution
backend/app/modules/member_snapshots.schema.py - contains schemas for member snapshots (used in API responses for workload data)
backend/app/modules/member_snapshots.services.py - contains check_workload_status function used for workload determination
backend/app/modules/tasks.model.py - contains Task model used for workload calculation and redistribution
backend/app/modules/tasks.enums.py - contains TaskStatus and Complexity enums used in workload calculation
backend/app/modules/tasks.services.py - contains TaskService used in workload_calculation and redistribution_logic
backend/app/modules/project_members.model.py - contains ProjectMember and Skills models used for eligibility
backend/app/modules/project_members.services.py - contains ProjectMemberService used in redistribution logic
backend/app/modules/projects.model.py - contains Project model used in workload calculation
backend/app/modules/projects.services.py - contains ProjectService used in redistribution logic
backend/app/modules/assigned_members.model.py - contains AssignedMember model used in workload calculation
backend/app/modules/assigned_members.services.py - contains AssignedMemberService used in redistribution logic and workload calculation

# Project Workload Calculation
backend/app/modules/project_snapshots.model.py - stores project-level workload aggregates (total_workload_points, avg_workload, workload_balance)
backend/app/modules/project_snapshots.schema.py - schemas for project snapshots
backend/app/modules/project_snapshots.services.py - service for project snapshot operations
backend/app/modules/project_snapshots.repo.py - repository for project snapshots
backend/app/modules/project_snapshots/routes.py - routes for project snapshots
